# AGP-OS Robot Deployment
# Production Docker image for real hardware

FROM ros:humble-ros-base

# Install Python dependencies
RUN apt-get update && apt-get install -y \
    python3-pip \
    python3-colcon-common-extensions \
    && rm -rf /var/lib/apt/lists/*

# Install AGP-OS dependencies
WORKDIR /app
COPY requirements.txt .
RUN pip3 install --no-cache-dir -r requirements.txt

# Copy AGP-OS source
COPY src/ ./src/
COPY tests/ ./tests/

# Install ROS2 Python packages
RUN pip3 install rclpy

# Environment
ENV PYTHONPATH=/app:$PYTHONPATH
ENV ROS_DOMAIN_ID=0

# Health check
HEALTHCHECK --interval=10s --timeout=3s \
    CMD python3 -c "from src.os.ros2.production import production_adapter; print(production_adapter.get_status())"

# Entry point
COPY deploy/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["python3", "-m", "src.main"]
